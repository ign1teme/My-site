# GitHub OAuth App credentials. Set these only in .env.local / Vercel settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must match the GitHub repository and Vercel production branch.
CMS_GITHUB_REPO=ign1teme/My-site
CMS_GITHUB_BRANCH=main
CMS_SITE_URL=https://hanam7.win
# Set true only for a private GitHub repository (requires the repo OAuth scope).
CMS_GITHUB_PRIVATE_REPO=false
